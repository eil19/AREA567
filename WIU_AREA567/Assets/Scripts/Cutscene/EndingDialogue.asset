  m_Script: {fileID: 11500000, guid: c983caf1021e8884c954b88e027cc82a, type: 3}
  m_Name: EndingDialogue
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneDialogue
  lines:
  - '"The Queen''s signal is fading..."'
  - '"The laboratory is finally quiet."'
  - '"Seven days ago, I stood here powerless against her."'
  - '"But this time, I was ready."'
  - '"The research we recovered, the laboratory we restored, and the allies we made
    changed everything."'
  - '"The future is ours again."'
